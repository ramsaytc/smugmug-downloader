# Optional: skip `smugmug-dl login` (which writes to ~/.config/smugmug-dl/credentials.json)
# by exporting these instead. Useful for CI or headless boxes. All four are required
# if you use this path; a partial set is ignored in favor of the saved credentials file.
SMUGMUG_API_KEY=
SMUGMUG_API_SECRET=
SMUGMUG_ACCESS_TOKEN=
SMUGMUG_ACCESS_TOKEN_SECRET=
